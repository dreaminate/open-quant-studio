{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-quant-studio.local/schemas/v1/forward-test-read-model.schema.json",
  "title": "Open Quant Studio Forward Test read model v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "forward_test_id",
    "source_run_id",
    "source_revision_id",
    "data_snapshot_id",
    "protocol_version",
    "released_bar_count",
    "transcript_artifact_id",
    "transcript_sha256",
    "intent_tape_sha256",
    "status",
    "error_code",
    "project_id",
    "activity_id",
    "variant_id",
    "created_at"
  ],
  "properties": {
    "forward_test_id": { "$ref": "#/$defs/uuid" },
    "source_run_id": { "$ref": "#/$defs/uuid" },
    "source_revision_id": { "$ref": "#/$defs/uuid" },
    "data_snapshot_id": { "$ref": "#/$defs/uuid" },
    "protocol_version": { "const": "oqs-forward-replay/m5-v1" },
    "released_bar_count": { "type": "integer", "minimum": 0, "maximum": 250000 },
    "transcript_artifact_id": { "$ref": "#/$defs/uuid" },
    "transcript_sha256": { "$ref": "#/$defs/sha256" },
    "intent_tape_sha256": { "$ref": "#/$defs/sha256" },
    "status": { "enum": ["passed", "failed"] },
    "error_code": {
      "oneOf": [
        { "enum": ["source_run_not_succeeded", "strategy_protocol_failed", "transcript_integrity_mismatch"] },
        { "type": "null" }
      ]
    },
    "project_id": { "$ref": "#/$defs/uuid" },
    "activity_id": { "$ref": "#/$defs/uuid" },
    "variant_id": { "$ref": "#/$defs/uuid" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "passed" } } },
      "then": { "properties": { "error_code": { "type": "null" } } },
      "else": {
        "properties": {
          "error_code": { "enum": ["source_run_not_succeeded", "strategy_protocol_failed", "transcript_integrity_mismatch"] }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
