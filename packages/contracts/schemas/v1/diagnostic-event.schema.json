{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-quant-studio.local/schemas/v1/diagnostic-event.schema.json",
  "title": "Open Quant Studio diagnostic lifecycle events v1",
  "allOf": [
    { "$ref": "https://open-quant-studio.local/schemas/v1/event-envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "event_type": { "enum": ["diagnostic.logs_deleted", "diagnostic.retention_applied"] },
        "variant_id": { "type": "null" },
        "base_revision_id": { "type": "null" },
        "payload": { "$ref": "#/$defs/receipt" }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "reason", "selection_sha256", "deleted_count", "completed_at"],
      "properties": {
        "receipt_id": { "$ref": "#/$defs/uuid" },
        "reason": { "enum": ["user", "retention", "quota"] },
        "selection_sha256": { "$ref": "#/$defs/sha256" },
        "deleted_count": { "type": "integer", "minimum": 0 },
        "completed_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
