{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-quant-studio.local/schemas/v1/command-envelope.schema.json",
  "title": "Open Quant Studio command envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command_id",
    "schema_version",
    "command_type",
    "project_id",
    "activity_id",
    "session_id",
    "workbench_id",
    "correlation_id",
    "expected_revision_id",
    "variant_id",
    "base_revision_id",
    "payload"
  ],
  "properties": {
    "command_id": { "$ref": "#/$defs/uuid" },
    "schema_version": { "const": 1 },
    "command_type": { "$ref": "#/$defs/namespacedType" },
    "project_id": { "$ref": "#/$defs/uuid" },
    "activity_id": { "$ref": "#/$defs/uuid" },
    "session_id": { "type": "string", "minLength": 1 },
    "workbench_id": { "type": "string", "minLength": 1 },
    "correlation_id": { "$ref": "#/$defs/uuid" },
    "expected_revision_id": {
      "oneOf": [
        { "$ref": "#/$defs/uuid" },
        { "type": "null" }
      ]
    },
    "variant_id": {
      "oneOf": [
        { "$ref": "#/$defs/uuid" },
        { "type": "null" }
      ]
    },
    "base_revision_id": {
      "oneOf": [
        { "$ref": "#/$defs/uuid" },
        { "type": "null" }
      ]
    },
    "payload": { "type": "object" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "namespacedType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
    }
  }
}
