{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-quant-studio.local/schemas/v1/formal-run-read-model.schema.json",
  "title": "Open Quant Studio formal Run read models v1",
  "oneOf": [
    { "$ref": "#/$defs/listReadModel" },
    { "$ref": "#/$defs/succeededDetail" },
    { "$ref": "#/$defs/failedDetail" },
    { "$ref": "#/$defs/m5SucceededDetail" },
    { "$ref": "#/$defs/m8SucceededDetail" },
    { "$ref": "#/$defs/m5FailedDetail" },
    { "$ref": "#/$defs/activeDetail" },
    { "$ref": "#/$defs/cancelledDetail" }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitOid": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "atom": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$"
    },
    "errorCode": {
      "enum": [
        "contract_gate_failed",
        "strategy_import_failed",
        "strategy_protocol_failed",
        "engine_input_missing",
        "engine_input_integrity_mismatch",
        "checkpoint_integrity_mismatch",
        "worker_interrupted_by_m5_upgrade",
        "smoke_run_failed",
        "engine_result_contract_failed"
      ]
    },
    "gateOutcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "strategy_import", "smoke_run"],
      "properties": {
        "contract": { "enum": ["passed", "failed"] },
        "strategy_import": { "enum": ["passed", "failed"] },
        "smoke_run": { "enum": ["passed", "failed"] }
      }
    },
    "passedGates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "strategy_import", "smoke_run"],
      "properties": {
        "contract": { "const": "passed" },
        "strategy_import": { "const": "passed" },
        "smoke_run": { "const": "passed" }
      }
    },
    "notRunGates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "strategy_import", "smoke_run"],
      "properties": {
        "contract": { "const": "not_run" },
        "strategy_import": { "const": "not_run" },
        "smoke_run": { "const": "not_run" }
      }
    },
    "artifact": {
      "$ref": "https://open-quant-studio.local/schemas/v1/artifact-read-model.schema.json"
    },
    "runSucceeded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "run_spec_id",
        "project_id",
        "activity_id",
        "variant_id",
        "candidate_revision_id",
        "status",
        "engine_result_artifact_id",
        "manifest_artifact_id",
        "calculation_hash",
        "error_code",
        "finished_at",
        "job_id",
        "queued_at",
        "started_at",
        "job_finished_at"
      ],
      "properties": {
        "run_id": { "$ref": "#/$defs/uuid" },
        "run_spec_id": { "$ref": "#/$defs/uuid" },
        "project_id": { "$ref": "#/$defs/uuid" },
        "activity_id": { "$ref": "#/$defs/uuid" },
        "variant_id": { "$ref": "#/$defs/uuid" },
        "candidate_revision_id": { "$ref": "#/$defs/uuid" },
        "status": { "const": "succeeded" },
        "engine_result_artifact_id": { "$ref": "#/$defs/uuid" },
        "manifest_artifact_id": { "$ref": "#/$defs/uuid" },
        "calculation_hash": { "$ref": "#/$defs/sha256" },
        "error_code": { "type": "null" },
        "finished_at": { "$ref": "#/$defs/dateTime" },
        "job_id": { "$ref": "#/$defs/uuid" },
        "queued_at": { "$ref": "#/$defs/dateTime" },
        "started_at": { "$ref": "#/$defs/dateTime" },
        "job_finished_at": { "$ref": "#/$defs/dateTime" }
      }
    },
    "runFailed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "run_spec_id",
        "project_id",
        "activity_id",
        "variant_id",
        "candidate_revision_id",
        "status",
        "engine_result_artifact_id",
        "manifest_artifact_id",
        "calculation_hash",
        "error_code",
        "finished_at",
        "job_id",
        "queued_at",
        "started_at",
        "job_finished_at"
      ],
      "properties": {
        "run_id": { "$ref": "#/$defs/uuid" },
        "run_spec_id": { "$ref": "#/$defs/uuid" },
        "project_id": { "$ref": "#/$defs/uuid" },
        "activity_id": { "$ref": "#/$defs/uuid" },
        "variant_id": { "$ref": "#/$defs/uuid" },
        "candidate_revision_id": { "$ref": "#/$defs/uuid" },
        "status": { "const": "failed" },
        "engine_result_artifact_id": { "type": "null" },
        "manifest_artifact_id": { "type": "null" },
        "calculation_hash": { "type": "null" },
        "error_code": { "$ref": "#/$defs/errorCode" },
        "finished_at": { "$ref": "#/$defs/dateTime" },
        "job_id": { "$ref": "#/$defs/uuid" },
        "queued_at": { "$ref": "#/$defs/dateTime" },
        "started_at": { "$ref": "#/$defs/dateTime" },
        "job_finished_at": { "$ref": "#/$defs/dateTime" }
      }
    },
    "runActive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id", "run_spec_id", "project_id", "activity_id", "variant_id",
        "candidate_revision_id", "status", "engine_result_artifact_id",
        "manifest_artifact_id", "calculation_hash", "error_code", "queued_at",
        "started_at", "finished_at", "execution_version", "checkpoint_seq",
        "next_bar_index", "retry_of_run_id", "validation_id", "validation_outcome", "gates"
      ],
      "properties": {
        "run_id": { "$ref": "#/$defs/uuid" },
        "run_spec_id": { "$ref": "#/$defs/uuid" },
        "project_id": { "$ref": "#/$defs/uuid" },
        "activity_id": { "$ref": "#/$defs/uuid" },
        "variant_id": { "$ref": "#/$defs/uuid" },
        "candidate_revision_id": { "$ref": "#/$defs/uuid" },
        "status": { "enum": ["pending", "running"] },
        "engine_result_artifact_id": { "type": "null" },
        "manifest_artifact_id": { "type": "null" },
        "calculation_hash": { "type": "null" },
        "error_code": { "type": "null" },
        "queued_at": { "$ref": "#/$defs/dateTime" },
        "started_at": {
          "oneOf": [{ "$ref": "#/$defs/dateTime" }, { "type": "null" }]
        },
        "finished_at": { "type": "null" },
        "execution_version": { "type": "integer", "minimum": 0 },
        "checkpoint_seq": { "type": "integer", "minimum": 0 },
        "next_bar_index": { "type": "integer", "minimum": 0, "maximum": 250000 },
        "retry_of_run_id": {
          "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
        },
        "validation_id": { "$ref": "#/$defs/uuid" },
        "validation_outcome": { "const": "not_run" },
        "gates": { "$ref": "#/$defs/notRunGates" }
        ,
        "job_id": { "$ref": "#/$defs/uuid" },
        "job_finished_at": { "type": "null" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "pending" } } },
          "then": {
            "properties": {
              "started_at": { "type": "null" },
              "execution_version": { "const": 0 },
              "checkpoint_seq": { "const": 0 },
              "next_bar_index": { "const": 0 }
            }
          },
          "else": {
            "properties": {
              "started_at": { "$ref": "#/$defs/dateTime" },
              "execution_version": { "type": "integer", "minimum": 1 }
            }
          }
        }
      ]
    },
    "runCancelled": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id", "run_spec_id", "project_id", "activity_id", "variant_id",
        "candidate_revision_id", "status", "engine_result_artifact_id",
        "manifest_artifact_id", "calculation_hash", "error_code", "queued_at",
        "started_at", "finished_at", "execution_version", "checkpoint_seq",
        "next_bar_index", "retry_of_run_id", "validation_id", "validation_outcome",
        "gates", "cancel_reason"
      ],
      "properties": {
        "run_id": { "$ref": "#/$defs/uuid" },
        "run_spec_id": { "$ref": "#/$defs/uuid" },
        "project_id": { "$ref": "#/$defs/uuid" },
        "activity_id": { "$ref": "#/$defs/uuid" },
        "variant_id": { "$ref": "#/$defs/uuid" },
        "candidate_revision_id": { "$ref": "#/$defs/uuid" },
        "status": { "const": "cancelled" },
        "engine_result_artifact_id": { "type": "null" },
        "manifest_artifact_id": { "type": "null" },
        "calculation_hash": { "type": "null" },
        "error_code": { "type": "null" },
        "queued_at": { "$ref": "#/$defs/dateTime" },
        "started_at": {
          "oneOf": [{ "$ref": "#/$defs/dateTime" }, { "type": "null" }]
        },
        "finished_at": { "$ref": "#/$defs/dateTime" },
        "execution_version": { "type": "integer", "minimum": 1 },
        "checkpoint_seq": { "type": "integer", "minimum": 0 },
        "next_bar_index": { "type": "integer", "minimum": 0, "maximum": 250000 },
        "retry_of_run_id": {
          "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
        },
        "validation_id": { "$ref": "#/$defs/uuid" },
        "validation_outcome": { "const": "not_run" },
        "gates": { "$ref": "#/$defs/notRunGates" },
        "cancel_reason": { "const": "user_requested" }
        ,
        "job_id": { "$ref": "#/$defs/uuid" },
        "job_finished_at": { "$ref": "#/$defs/dateTime" }
      }
    },
    "runSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_spec_id",
        "project_id",
        "activity_id",
        "variant_id",
        "candidate_revision_id",
        "engine_input_artifact_id",
        "data_snapshot_id",
        "data_snapshot_sha256",
        "strategy_tree_oid",
        "parameters_sha256",
        "cost_model_sha256",
        "environment_lock_sha256",
        "engine_version",
        "price_basis",
        "cutoff",
        "timezone",
        "sample_start",
        "sample_end",
        "random_seed",
        "output_schema_version",
        "gate_policy_version",
        "spec_hash",
        "created_at"
      ],
      "properties": {
        "run_spec_id": { "$ref": "#/$defs/uuid" },
        "project_id": { "$ref": "#/$defs/uuid" },
        "activity_id": { "$ref": "#/$defs/uuid" },
        "variant_id": { "$ref": "#/$defs/uuid" },
        "candidate_revision_id": { "$ref": "#/$defs/uuid" },
        "engine_input_artifact_id": { "$ref": "#/$defs/uuid" },
        "data_snapshot_id": { "$ref": "#/$defs/uuid" },
        "data_snapshot_sha256": { "$ref": "#/$defs/sha256" },
        "strategy_tree_oid": { "$ref": "#/$defs/gitOid" },
        "parameters_sha256": { "$ref": "#/$defs/sha256" },
        "cost_model_sha256": { "$ref": "#/$defs/sha256" },
        "environment_lock_sha256": { "$ref": "#/$defs/sha256" },
        "engine_version": { "const": "oqs-quant-engine/0.1.0" },
        "price_basis": { "enum": ["raw", "qfq", "hfq"] },
        "cutoff": { "$ref": "#/$defs/dateTime" },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 64 },
        "sample_start": { "$ref": "#/$defs/dateTime" },
        "sample_end": { "$ref": "#/$defs/dateTime" },
        "random_seed": { "type": "integer", "minimum": 0 },
        "output_schema_version": { "const": 1 },
        "gate_policy_version": { "const": "m3-v1" },
        "spec_hash": { "$ref": "#/$defs/sha256" },
        "created_at": { "$ref": "#/$defs/dateTime" }
      }
    },
    "m5RunSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_spec_id", "project_id", "activity_id", "variant_id", "candidate_revision_id",
        "market_input_artifact_id", "data_snapshot_id", "data_snapshot_sha256",
        "strategy_tree_oid", "parameters_sha256", "cost_model_sha256",
        "environment_lock_sha256", "engine_version", "price_basis", "cutoff",
        "timezone", "sample_start", "sample_end", "random_seed", "output_schema_version",
        "gate_policy_version", "strategy_protocol_version", "checkpoint_batch_size",
        "engine_checkpoint_abi", "spec_hash", "created_at"
      ],
      "properties": {
        "run_spec_id": { "$ref": "#/$defs/uuid" },
        "project_id": { "$ref": "#/$defs/uuid" },
        "activity_id": { "$ref": "#/$defs/uuid" },
        "variant_id": { "$ref": "#/$defs/uuid" },
        "candidate_revision_id": { "$ref": "#/$defs/uuid" },
        "market_input_artifact_id": { "$ref": "#/$defs/uuid" },
        "data_snapshot_id": { "$ref": "#/$defs/uuid" },
        "data_snapshot_sha256": { "$ref": "#/$defs/sha256" },
        "strategy_tree_oid": { "$ref": "#/$defs/gitOid" },
        "parameters_sha256": { "$ref": "#/$defs/sha256" },
        "cost_model_sha256": { "$ref": "#/$defs/sha256" },
        "environment_lock_sha256": { "$ref": "#/$defs/sha256" },
        "engine_version": { "enum": ["oqs-quant-engine/0.1.0", "oqs-quant-engine/0.2.0"] },
        "price_basis": { "enum": ["raw", "qfq", "hfq"] },
        "cutoff": { "$ref": "#/$defs/dateTime" },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 64 },
        "sample_start": { "$ref": "#/$defs/dateTime" },
        "sample_end": { "$ref": "#/$defs/dateTime" },
        "random_seed": { "type": "integer", "minimum": 0 },
        "output_schema_version": { "enum": [1, 2] },
        "gate_policy_version": { "enum": ["m5-v1", "m8-v1"] },
        "strategy_protocol_version": { "enum": ["oqs-strategy-host/m5-stream-v2", "oqs-strategy-host/m8-portfolio-v1"] },
        "checkpoint_batch_size": { "type": "integer", "minimum": 1, "maximum": 250000 },
        "engine_checkpoint_abi": { "enum": ["oqs-quant-engine/checkpoint-v1", "oqs-quant-engine/checkpoint-v2"] },
        "spec_hash": { "$ref": "#/$defs/sha256" },
        "created_at": { "$ref": "#/$defs/dateTime" }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "engine_version": { "const": "oqs-quant-engine/0.1.0" },
                "output_schema_version": { "const": 1 },
                "gate_policy_version": { "const": "m5-v1" },
                "strategy_protocol_version": { "const": "oqs-strategy-host/m5-stream-v2" },
                "engine_checkpoint_abi": { "const": "oqs-quant-engine/checkpoint-v1" }
              }
            },
            {
              "properties": {
                "engine_version": { "const": "oqs-quant-engine/0.2.0" },
                "output_schema_version": { "const": 2 },
                "gate_policy_version": { "const": "m8-v1" },
                "strategy_protocol_version": { "const": "oqs-strategy-host/m8-portfolio-v1" },
                "engine_checkpoint_abi": { "const": "oqs-quant-engine/checkpoint-v2" }
              }
            }
          ]
        }
      ]
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation_id",
        "gate_policy_version",
        "engine_version",
        "gates",
        "outcome",
        "manifest_artifact_id",
        "created_at"
      ],
      "properties": {
        "validation_id": { "$ref": "#/$defs/uuid" },
        "gate_policy_version": { "const": "m3-v1" },
        "engine_version": { "const": "oqs-quant-engine/0.1.0" },
        "gates": { "$ref": "#/$defs/gateOutcomes" },
        "outcome": { "enum": ["passed", "failed"] },
        "manifest_artifact_id": {
          "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
        },
        "created_at": { "$ref": "#/$defs/dateTime" }
      }
    },
    "m5Validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validation_id", "gate_policy_version", "engine_version", "gates", "outcome", "manifest_artifact_id", "created_at"],
      "properties": {
        "validation_id": { "$ref": "#/$defs/uuid" },
        "gate_policy_version": { "enum": ["m5-v1", "m8-v1"] },
        "engine_version": { "enum": ["oqs-quant-engine/0.1.0", "oqs-quant-engine/0.2.0"] },
        "gates": {
          "oneOf": [
            { "$ref": "#/$defs/gateOutcomes" },
            { "$ref": "#/$defs/notRunGates" }
          ]
        },
        "outcome": { "enum": ["passed", "failed", "not_run"] },
        "manifest_artifact_id": {
          "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
        },
        "created_at": { "$ref": "#/$defs/dateTime" }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "gate_policy_version": { "const": "m5-v1" },
                "engine_version": { "const": "oqs-quant-engine/0.1.0" }
              }
            },
            {
              "properties": {
                "gate_policy_version": { "const": "m8-v1" },
                "engine_version": { "const": "oqs-quant-engine/0.2.0" }
              }
            }
          ]
        }
      ]
    },
    "intentEventKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_seq", "phase", "stable_seq"],
      "properties": {
        "session_seq": { "type": "integer", "minimum": 0 },
        "phase": { "enum": ["open", "intrabar", "close"] },
        "stable_seq": { "type": "integer", "minimum": 0 }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent_id",
        "intent_seq",
        "symbol",
        "side",
        "position_effect",
        "quantity",
        "order_type",
        "known_at",
        "effective_at",
        "limit_price_atoms",
        "stop_price_atoms",
        "time_in_force",
        "oco_group"
      ],
      "properties": {
        "intent_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "intent_seq": { "type": "integer", "minimum": 0 },
        "symbol": { "type": "string", "minLength": 1, "maxLength": 64 },
        "side": { "enum": ["buy", "sell"] },
        "position_effect": { "enum": ["open", "close"] },
        "quantity": { "$ref": "#/$defs/atom" },
        "order_type": { "enum": ["market", "limit", "stop"] },
        "known_at": { "$ref": "#/$defs/intentEventKey" },
        "effective_at": { "$ref": "#/$defs/intentEventKey" },
        "limit_price_atoms": {
          "oneOf": [{ "$ref": "#/$defs/atom" }, { "type": "null" }]
        },
        "stop_price_atoms": {
          "oneOf": [{ "$ref": "#/$defs/atom" }, { "type": "null" }]
        },
        "time_in_force": { "enum": ["day", "gtc"] },
        "oco_group": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 256 },
            { "type": "null" }
          ]
        }
      }
    },
    "intentTape": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/intent" }
    },
    "logs": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "https://open-quant-studio.local/schemas/v1/diagnostic-log.schema.json"
      }
    },
    "listEntrySucceeded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "run_spec_id",
        "project_id",
        "activity_id",
        "variant_id",
        "candidate_revision_id",
        "status",
        "engine_result_artifact_id",
        "manifest_artifact_id",
        "calculation_hash",
        "error_code",
        "finished_at",
        "validation_id",
        "validation_outcome",
        "gates"
      ],
      "properties": {
        "run_id": { "$ref": "#/$defs/uuid" },
        "run_spec_id": { "$ref": "#/$defs/uuid" },
        "project_id": { "$ref": "#/$defs/uuid" },
        "activity_id": { "$ref": "#/$defs/uuid" },
        "variant_id": { "$ref": "#/$defs/uuid" },
        "candidate_revision_id": { "$ref": "#/$defs/uuid" },
        "status": { "const": "succeeded" },
        "engine_result_artifact_id": { "$ref": "#/$defs/uuid" },
        "manifest_artifact_id": { "$ref": "#/$defs/uuid" },
        "calculation_hash": { "$ref": "#/$defs/sha256" },
        "error_code": { "type": "null" },
        "finished_at": { "$ref": "#/$defs/dateTime" },
        "validation_id": { "$ref": "#/$defs/uuid" },
        "validation_outcome": { "const": "passed" },
        "gates": { "$ref": "#/$defs/passedGates" }
      }
    },
    "listEntryFailed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "run_spec_id",
        "project_id",
        "activity_id",
        "variant_id",
        "candidate_revision_id",
        "status",
        "engine_result_artifact_id",
        "manifest_artifact_id",
        "calculation_hash",
        "error_code",
        "finished_at",
        "validation_id",
        "validation_outcome",
        "gates"
      ],
      "properties": {
        "run_id": { "$ref": "#/$defs/uuid" },
        "run_spec_id": { "$ref": "#/$defs/uuid" },
        "project_id": { "$ref": "#/$defs/uuid" },
        "activity_id": { "$ref": "#/$defs/uuid" },
        "variant_id": { "$ref": "#/$defs/uuid" },
        "candidate_revision_id": { "$ref": "#/$defs/uuid" },
        "status": { "const": "failed" },
        "engine_result_artifact_id": { "type": "null" },
        "manifest_artifact_id": { "type": "null" },
        "calculation_hash": { "type": "null" },
        "error_code": { "$ref": "#/$defs/errorCode" },
        "finished_at": { "$ref": "#/$defs/dateTime" },
        "validation_id": { "$ref": "#/$defs/uuid" },
        "validation_outcome": { "const": "failed" },
