{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-quant-studio.local/schemas/v1/forward-test-command.schema.json",
  "title": "Open Quant Studio local historical Forward Test command v1",
  "allOf": [
    { "$ref": "https://open-quant-studio.local/schemas/v1/command-envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "command_type": { "const": "forward_test.request" },
        "expected_revision_id": { "$ref": "#/$defs/uuid" },
        "variant_id": { "$ref": "#/$defs/uuid" },
        "base_revision_id": { "$ref": "#/$defs/uuid" },
        "payload": { "$ref": "#/$defs/requestPayload" }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "requestPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forward_test_id", "source_run_id", "protocol_version"],
      "properties": {
        "forward_test_id": { "$ref": "#/$defs/uuid" },
        "source_run_id": { "$ref": "#/$defs/uuid" },
        "protocol_version": { "const": "oqs-forward-replay/m5-v1" }
      }
    }
  }
}
